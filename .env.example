# Copy this file to `.env` and fill in real values.
# The real `.env` is gitignored and must NEVER be committed.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=          # generate: openssl rand -hex 24
POSTGRES_DB=n8n

# ---------------------------------------------------------------------------
# n8n encryption key  —  THE MASTER KEY. Read the README before touching this.
# ---------------------------------------------------------------------------
# Decrypts every stored credential (email, Azure, Mistral, delivery creds).
# Treat it like a root password.
#   - Generate once:  openssl rand -hex 32
#   - Set it BEFORE the first run, or n8n auto-generates its own and a later
#     mismatch will refuse to start.
#   - Store the value in a password manager / secrets vault, NOT just here.
#   - Losing it = every credential becomes undecryptable on restore.
N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Task runner shared secret  —  REQUIRED
# ---------------------------------------------------------------------------
# Shared auth token between n8n and the external `n8n-runners` container. Both
# services read this SAME value; if it is empty or mismatched the runner fails
# to register and Code nodes won't execute.
#   - Generate once:  openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# For local prototyping the defaults below are fine. Once a domain + reverse
# proxy / VPN is in place, set these to the real public values.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Vancouver

# ---------------------------------------------------------------------------
# Optional: Python extractor sidecar (uncomment the service in compose first)
# ---------------------------------------------------------------------------
# AZURE_DI_KEY=
# MISTRAL_API_KEY=

# ---------------------------------------------------------------------------
# Discord <-> n8n bridge (the `discord-bot` service)
# ---------------------------------------------------------------------------
# Bot token: https://discord.com/developers/applications -> your app -> Bot ->
# Reset Token. REQUIRED. Also enable the "Message Content Intent" there, or
# login fails with a "disallowed intents" error (the #1 setup gotcha).
DISCORD_TOKEN=
# Optional. Application ID (General Information page); only needed later if you
# add slash-command registration.
DISCORD_CLIENT_ID=
# Optional. Pin the bot to a single guild for local development.
DISCORD_GUILD_ID=

# Shared secret n8n must present (Authorization: Bearer <this>) on every call
# to the bot's command API. REQUIRED. Generate a strong one: openssl rand -hex 32
# Use the SAME value in your n8n workflow's HTTP Request "Authorization" header.
BOT_API_TOKEN=

# --- The rest have working defaults; override only if you need to. ---
# n8n Webhook node URL the bot forwards Discord events to. The default resolves
# the n8n container by name on this compose network. Use /webhook-test/... while
# building a workflow; /webhook/... once the workflow is ACTIVE.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/discord-events
# Optional shared secret sent TO n8n. To use it, add a "Header Auth" credential
# to the Webhook node: Name = N8N_WEBHOOK_HEADER below, Value = this token.
N8N_WEBHOOK_TOKEN=
N8N_WEBHOOK_HEADER=authorization
# Port the bot's command API listens on (internal to the compose network only).
BOT_HTTP_PORT=3000
# Forward member join/leave events. Needs the PRIVILEGED Server Members Intent
# (enable it in the Developer Portal too). Off by default.
FORWARD_MEMBER_EVENTS=false
# Skip messages authored by bots (recommended — avoids noise & feedback loops).
IGNORE_BOT_MESSAGES=true
# Bot log verbosity: error | warn | info | debug
LOG_LEVEL=info

